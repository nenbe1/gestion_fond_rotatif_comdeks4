# URL de l'API backend. En développement, laissez cette ligne commentée
# ou absente : l'application détecte automatiquement l'adresse (fonctionne
# depuis localhost comme depuis une IP du réseau local).
#
# En production, décommentez et renseignez l'adresse réelle du backend
# hébergé (voir le manuel d'installation) :
# VITE_API_URL=https://api.votredomaine.com/api
